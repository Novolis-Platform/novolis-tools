<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>novolis-solution</ToolCommandName>
    <PackageId>Novolis.Solution.Tool</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Solution.Tool</RootNamespace>
    <Description>Query typed SLNX topology and solution catalogs from the command line.</Description>
    <PackageTags>novolis;solution;slnx;msbuild;roslyn;tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <LibraryReference Include="Novolis.Workspaces.DotNet.Abstractions" />
    <LibraryReference Include="Novolis.Workspaces.DotNet.Indexing" />
    <LibraryReference Include="Novolis.Workspaces.DotNet.MSBuild" />
    <LibraryReference Include="Novolis.Workspaces.DotNet.Slnx" />
    <PackageReference Include="System.IO.Abstractions" />
  </ItemGroup>
</Project>
