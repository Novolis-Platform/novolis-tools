<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Tools.Docs</PackageId>
    <Description>Markdown and Mermaid builders, plus multi-repo docs/ static HTML site generation via Novolis.Markup.</Description>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Tools.Docs</RootNamespace>
    <PackageTags>novolis;markdown;mermaid;documentation;graph;docs;html;site</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <LibraryReference Include="Novolis.Markup.Markdown" />
    <LibraryReference Include="Novolis.Markup.Markdown.Rendering" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Marketing\platform-repo-catalog.json" />
  </ItemGroup>
</Project>
