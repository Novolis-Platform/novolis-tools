<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Tools.AgentDev</PackageId>
    <Description>Capability-gated development, debug, and test agent profile.</Description>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Tools.AgentDev</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageTags>novolis;agent;mcp;development;debug;test</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <LibraryReference Include="Novolis.Agent.Core" />
    <LibraryReference Include="Novolis.Agent.Surface" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
