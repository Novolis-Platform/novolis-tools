<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>novolis-manuscript</ToolCommandName>
    <PackageId>Novolis.Manuscript.Cli</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Manuscript.Cli</RootNamespace>
    <Description>CLI for manuscript book surgery, audiobook generation, print, metrics, and editorial lint.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Core" />
    <LibraryReference Include="Novolis.Audio.Voice.AzureSpeech" />
    <LibraryReference Include="Novolis.IO.Paths" />
    <LibraryReference Include="Novolis.Manuscript" />
    <LibraryReference Include="Novolis.Manuscript.Editorial" />
    <LibraryReference Include="Novolis.Manuscript.Export.Audio" />
    <LibraryReference Include="Novolis.Manuscript.Export.Markdown" />
    <LibraryReference Include="Novolis.Manuscript.Export.Pdf" />
    <LibraryReference Include="Novolis.Manuscript.IO" />
    <LibraryReference Include="Novolis.Manuscript.Metrics" />
  </ItemGroup>
</Project>
