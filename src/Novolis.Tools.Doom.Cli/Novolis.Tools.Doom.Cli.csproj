<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>Novolis.Tools.Doom.Cli</PackageId>
    <Description>dotnet tool novolis-doom — extract classic Doom WAD maps and resources.</Description>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>novolis-doom</ToolCommandName>
    <RootNamespace>Novolis.Tools.Doom.Cli</RootNamespace>
    <PackageTags>novolis;doom;wad;iwad;pwad;extract;game;asset</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novolis.AssetStudio.Import\Novolis.AssetStudio.Import.csproj" />
    <LibraryReference Include="Novolis.Visual.Baking" />
    <LibraryReference Include="Novolis.Visual.Definitions" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>
