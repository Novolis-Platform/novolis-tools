<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Tools.MarkdownPdf</PackageId>
    <Description>Markdown → PDF converter with named themes over Novolis.Markup.Markdown.Documents + Documents.Skia.</Description>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Tools.MarkdownPdf</RootNamespace>
    <PackageTags>novolis;markdown;pdf;documents;theme;tools</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <LibraryReference Include="Novolis.Documents" />
    <LibraryReference Include="Novolis.Documents.Skia" />
    <LibraryReference Include="Novolis.Markup.Markdown" />
    <LibraryReference Include="Novolis.Markup.Markdown.Documents" />
    <LibraryReference Include="Novolis.Math.Measure" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
  </ItemGroup>
</Project>
