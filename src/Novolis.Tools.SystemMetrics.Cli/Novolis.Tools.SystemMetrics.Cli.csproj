<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>Novolis.Tools.SystemMetrics.Cli</PackageId>
    <Description>dotnet tool novolis-system-metrics — Spectre.Console system resource capture.</Description>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>novolis-system-metrics</ToolCommandName>
    <RootNamespace>Novolis.Tools.SystemMetrics.Cli</RootNamespace>
    <PackageTags>novolis;system;metrics;cpu;gpu;network;display;diagnostics;cli;dotnet-tool;spectre</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
    <ProjectReference Include="..\Novolis.Tools.Cli\Novolis.Tools.Cli.csproj" />
    <LibraryReference Include="Novolis.IO.SystemMetrics" />
    <InternalsVisibleTo Include="Novolis.Tools.SystemMetrics.Cli.Unit" />
  </ItemGroup>
</Project>
