<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>Novolis.Tools.Docs.Cli</PackageId>
    <Description>dotnet tool novolis-docs — scaffold Markdown/Mermaid doc packs and emit .csproj relationship graphs.</Description>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>novolis-docs</ToolCommandName>
    <RootNamespace>Novolis.Tools.Docs.Cli</RootNamespace>
    <PackageTags>novolis;docs;markdown;mermaid;cli;dotnet-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <ProjectReference Include="..\Novolis.Tools.Docs\Novolis.Tools.Docs.csproj" />
  </ItemGroup>
</Project>
